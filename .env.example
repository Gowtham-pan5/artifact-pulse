# Artifact-Pulse environment configuration
# Copy to .env and populate before running the server.

# JWT secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-random-secret

# Comma-separated list of allowed CORS origins for the React UI
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Flask environment (development | production)
FLASK_ENV=production

# Server bind address and port
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# JWT access token expiry in minutes
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
